APP_NAME="Guruji Cash Logistics & Retailer CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Kolkata"
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL 8.0 / MariaDB Database Connection (Standard on Hostinger Cloud)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_guruji
DB_USERNAME=u123456789_admin
DB_PASSWORD="your_strong_mysql_password"

# Session & Cache Settings (Database or Redis)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
CACHE_PREFIX=guruji_cache_

# Queue Driver (Database queue is default fallback without mandatory Redis)
QUEUE_CONNECTION=database

# Real-Time WebSockets (Optional Reverb with AJAX Polling Fallback)
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=https

# Storage Disk Configuration
FILESYSTEM_DISK=local

# Google Maps API Configuration (Admin Radar & Geofence Verification)
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"
GOOGLE_MAPS_SERVER_KEY="YOUR_GOOGLE_MAPS_SERVER_KEY_HERE"

# Firebase Cloud Messaging (FCM Push Notifications for Pickups, Reminders, SOS)
FCM_SERVER_KEY="YOUR_FIREBASE_CLOUD_MESSAGING_SERVER_KEY"
FCM_SENDER_ID="YOUR_FIREBASE_SENDER_ID"
FIREBASE_CREDENTIALS_PATH="storage/app/firebase-auth.json"

# Core Operational Safety Thresholds (Configurable via Admin Settings)
COLLECTOR_FLOAT_LIMIT_PAISE=10000000
GEOFENCE_RADIUS_METERS=100
BROADCAST_COUNTDOWN_SECONDS=90
PENALTY_FREE_WINDOW_SECONDS=180
PENALTY_AMOUNT_PAISE=5000
PENALTY_COLLECTOR_SHARE_PERCENT=70

# Recharge & BBPS Provider Integrations (Sandbox / Production Switch)
RECHARGE_PROVIDER=mock
RECHARGE_API_KEY=
RECHARGE_API_SECRET=
RECHARGE_BASE_URL="https://api.recharge-partner.com/v1"

BBPS_PROVIDER=mock
BBPS_AGENT_ID=
BBPS_AGENT_KEY=
BBPS_BASE_URL="https://api.bbps-partner.com/v2"

# Mail SMTP Settings for Reports & Admin Critical Alerts
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD="your_email_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
