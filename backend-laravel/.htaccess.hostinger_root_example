# ----------------------------------------------------------------------
# GURUJI PLATFORM — ROOT .HTACCESS FOR HOSTINGER CLOUD / CPANEL
# Use this ONLY if you cannot change the public document root in Hostinger hPanel.
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive directories and dot-files
    RewriteRule ^(\.env|\.git|storage/|bootstrap/cache|database/|resources/|app/) - [F,L]

    # Route all normal web traffic to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,QSA]
</IfModule>
